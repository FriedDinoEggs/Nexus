        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "histogram_quantile(0.99, sum(rate(django_http_requests_latency_seconds_by_view_method_bucket[$__rate_interval])) by (le, view))",
          "legendFormat": "p99 {{view}}",
          "refId": "C"
        }
