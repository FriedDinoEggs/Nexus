      "id": 2,
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(rate(django_http_requests_total_by_view_transport_method_total[$__rate_interval])) by (view, method)",
