          "refId": "A"
        }
      ],
      "title": "HTTP Request Rate (by view)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
